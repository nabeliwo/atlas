/**
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,

  "d1_databases": [
    {
      // アプリ側は env.DB で参照する。バインディング名を変えるとコードが動かない。
      "binding": "DB",
      "database_name": "atlas-db",
      // `npx wrangler d1 create atlas-db` で作成した本番DBのID。
      // これ単体ではアクセスできない識別子なので、秘密情報ではない。
      // ローカル開発では使われない（.wrangler/state 以下の SQLite を見る）。
      "database_id": "e9bfa1a8-8834-4c4a-a7cb-4c4fc14b7409",
      "migrations_dir": "db/migrations"
    }
  ],

  // 本番の BETTER_AUTH_URL。デプロイ先の URL と一致している必要がある。
  // これが実際のURLと違うと OAuth のコールバックが成立しない。
  // ローカル開発では .dev.vars の値が優先されるため影響しない。
  "vars": {
    "BETTER_AUTH_URL": "https://atlas.nabeliwo.workers.dev"
  }

  /**
   * Secrets（wrangler secret put で登録し、リポジトリには置かない）
   * - GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
   * - BETTER_AUTH_SECRET
   * - ADMIN_GOOGLE_EMAIL
   * - PLACE_SEARCH_API_KEY
   */
}
